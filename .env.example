# App. None of these are NEXT_PUBLIC_-prefixed, and that is the point: Next
# inlines any NEXT_PUBLIC_ variable into the browser bundle at build time, so
# the prefix is what decides whether a value can reach a client, not how the
# value is used. The publishable key is safe to expose and still does not need
# to be — nothing in this app runs Supabase from the browser.
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Signs the password-reset marker cookie. Any long random string.
RECOVERY_MARKER_SECRET=
# Signs card source links so the full report fetches only links the server wrote. Any random string of 32+ characters (e.g. `openssl rand -base64 32`). Set it before deploying: cards written without it are stored unsigned and never get page text.
SOURCE_LINK_SECRET=

# Invite requests (/request-invite, /admin/requests). All server-only.
# Sends the invite, decline and new-request emails through Resend's API. A sending-only key restricted to h72labs.com.
RESEND_API_KEY=
# Where new-request notices go (Tarek's inbox). Without it, requests still land on the admin page.
ADMIN_NOTIFY_EMAIL=
# Lets this server, and nothing else, call submit_invite_request. 32+ random characters (`openssl rand -base64 32`); the database holds its sha256 in invite_request_config.server_key_hash. Also keys the per-visitor hash, so rotating it resets the per-visitor cap.
INVITE_REQUEST_SECRET=
# Cloudflare Turnstile. The site key is public by design, but it is read on the server per request like everything else here. For local development, Cloudflare's always-pass test keys work: 1x00000000000000000000AA and 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin-only, for `npm run invite`. These go in a separate .env.admin
# (gitignored), NOT in .env.local and NEVER in Vercel: the secret key bypasses
# row-level security. SUPABASE_URL is the same project URL as above — it is
# repeated because .env.admin is loaded on its own, by that script only.
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# INVITE_BASE_URL=https://news.h72labs.com
